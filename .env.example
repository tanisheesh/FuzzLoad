# FuzzLoad Environment Configuration
# Copy this file to .env and adjust as needed. Never commit .env files.

# Frontend Dashboard → Backend Control Plane URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend AI Control Plane Configuration
PORT=8000
CORS_ORIGINS=http://localhost:3000,https://fuzzload.tanisheesh.in

# Go Data Plane Reverse Proxy URL (used when Go proxy container/process is running)
GO_PROXY_URL=http://localhost:8080
GO_PROXY_PORT=8080

# Neuro-Fuzzy (ANFIS) Fast Loop Hyperparameters
ANFIS_LEARNING_RATE=0.015
ANFIS_SLA_TARGET_MS=85.0
ANFIS_FAST_LOOP_MS=500

# Genetic Programming (GP) Slow Loop Hyperparameters
GP_POPULATION_SIZE=40
GP_GENERATIONS_PER_CYCLE=12
GP_SLOW_LOOP_SEC=6
GP_BLENDING_LAMBDA=0.60
