# FuzzLoad Environment Variables
# Copy this file to .env (and frontend/.env.local if customizing API URL). Never commit .env files.

# Frontend Dashboard -> Python AI Control Plane URL (e.g. http://localhost:8000 or Render service URL)
NEXT_PUBLIC_API_URL=

# Python AI Control Plane listening port (default 8000)
PORT=

# Comma-separated allowed CORS origins for FastAPI (e.g. http://localhost:3000,https://fuzzload.tanisheesh.in)
CORS_ORIGINS=

# Go Data Plane Reverse Proxy URL polled by the Python Control Plane (default http://127.0.0.1:8080)
GO_PROXY_URL=

# Go Data Plane Reverse Proxy listening port (default 8080)
GO_PROXY_PORT=

# Optional bearer token protecting POST /api/weights and POST /api/chaos on Go Proxy (generate via `openssl rand -hex 24`)
FUZZLOAD_ADMIN_TOKEN=

# Optional internal Go load generator RPS against local worker nodes (default 0; Docker sets 120)
GO_LOADGEN_RPS=

# Optional initial routing policy (fuzzload | anfis_only | weighted_round_robin | least_connections | round_robin)
FUZZLOAD_POLICY=

# Optional comma-separated upstream URLs and matching relative weights
FUZZLOAD_UPSTREAMS=
FUZZLOAD_WEIGHTS=

# Neuro-Fuzzy (ANFIS) Fast Loop Hyperparameters (defaults: 0.015, 85.0)
ANFIS_LEARNING_RATE=
ANFIS_SLA_TARGET_MS=

# Genetic Programming (GP) Slow Loop Hyperparameters (defaults: 36, 0.58)
GP_POPULATION_SIZE=
GP_BLENDING_LAMBDA=
